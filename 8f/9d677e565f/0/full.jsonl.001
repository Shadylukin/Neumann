{"parentUuid":"5df85691-49fc-493c-a324-1be941575dcd","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YDxRiJNdpdavAphMarwutj","type":"tool_result","content":"     1→// SPDX-License-Identifier: MIT OR Apache-2.0\n     2→#![allow(missing_docs)]\n     3→use criterion::{black_box, criterion_group, criterion_main, BenchmarkId, Criterion};\n     4→use neumann_shell::Shell;\n     5→use peak_alloc::PeakAlloc;\n     6→\n     7→#[global_allocator]\n     8→static PEAK_ALLOC: PeakAlloc = PeakAlloc;\n     9→\n    10→fn bench_execute_commands(c: &mut Criterion) {\n    11→    let mut group = c.benchmark_group(\"shell_execute\");\n    12→\n    13→    PEAK_ALLOC.reset_peak_usage();\n    14→    group.bench_function(\"empty_input\", |b| {\n    15→        b.iter_batched(\n    16→            Shell::new,\n    17→            |mut shell| {\n    18→                let result = shell.execute(black_box(\"\"));\n    19→                black_box(result)\n    20→            },\n    21→            criterion::BatchSize::SmallInput,\n    22→        );\n    23→    });\n    24→    println!(\n    25→        \"\\n  empty_input peak RAM: {:.1} KB\",\n    26→        PEAK_ALLOC.peak_usage_as_kb()\n    27→    );\n    28→\n    29→    PEAK_ALLOC.reset_peak_usage();\n    30→    group.bench_function(\"help\", |b| {\n    31→        b.iter_batched(\n    32→            Shell::new,\n    33→            |mut shell| {\n    34→                let result = shell.execute(black_box(\"help\"));\n    35→                black_box(result)\n    36→            },\n    37→            criterion::BatchSize::SmallInput,\n    38→        );\n    39→    });\n    40→    println!(\"  help peak RAM: {:.1} KB\", PEAK_ALLOC.peak_usage_as_kb());\n    41→\n    42→    PEAK_ALLOC.reset_peak_usage();\n    43→    group.bench_function(\"select_all\", |b| {\n    44→        b.iter_batched(\n    45→            || {\n    46→                let mut shell = Shell::new();\n    47→                let _ = shell.execute(\"CREATE TABLE users (id INT, name TEXT)\");\n    48→                for i in 0..100 {\n    49→                    let _ = shell.execute(&format!(\"INSERT INTO users VALUES ({i}, 'user{i}')\"));\n    50→                }\n    51→                shell\n    52→            },\n    53→            |mut shell| {\n    54→                let result = shell.execute(black_box(\"SELECT * FROM users\"));\n    55→                black_box(result)\n    56→            },\n    57→            criterion::BatchSize::SmallInput,\n    58→        );\n    59→    });\n    60→    println!(\n    61→        \"  select_all peak RAM: {:.1} KB\",\n    62→        PEAK_ALLOC.peak_usage_as_kb()\n    63→    );\n    64→\n    65→    PEAK_ALLOC.reset_peak_usage();\n    66→    group.bench_function(\"select_where\", |b| {\n    67→        b.iter_batched(\n    68→            || {\n    69→                let mut shell = Shell::new();\n    70→                let _ = shell.execute(\"CREATE TABLE users (id INT, name TEXT)\");\n    71→                for i in 0..100 {\n    72→                    let _ = shell.execute(&format!(\"INSERT INTO users VALUES ({i}, 'user{i}')\"));\n    73→                }\n    74→                shell\n    75→            },\n    76→            |mut shell| {\n    77→                let result = shell.execute(black_box(\"SELECT * FROM users WHERE id = 50\"));\n    78→                black_box(result)\n    79→            },\n    80→            criterion::BatchSize::SmallInput,\n    81→        );\n    82→    });\n    83→    println!(\n    84→        \"  select_where peak RAM: {:.1} KB\",\n    85→        PEAK_ALLOC.peak_usage_as_kb()\n    86→    );\n    87→\n    88→    group.finish();\n    89→}\n    90→\n    91→fn bench_format_output(c: &mut Criterion) {\n    92→    let mut group = c.benchmark_group(\"shell_format\");\n    93→\n    94→    PEAK_ALLOC.reset_peak_usage();\n    95→    group.bench_with_input(\n    96→        BenchmarkId::new(\"format_rows\", 1000),\n    97→        &1000,\n    98→        |b, &row_count| {\n    99→            b.iter_batched(\n   100→                || {\n   101→                    let mut shell = Shell::new();\n   102→                    let _ = shell.execute(\"CREATE TABLE bench (id INT, name TEXT, email TEXT)\");\n   103→                    for i in 0..row_count {\n   104→                        let _ = shell.execute(&format!(\n   105→                            \"INSERT INTO bench VALUES ({i}, 'user{i}', 'user{i}@example.com')\"\n   106→                        ));\n   107→                    }\n   108→                    shell\n   109→                },\n   110→                |mut shell| {\n   111→                    let result = shell.execute(black_box(\"SELECT * FROM bench\"));\n   112→                    black_box(result)\n   113→                },\n   114→                criterion::BatchSize::SmallInput,\n   115→            );\n   116→        },\n   117→    );\n   118→    println!(\n   119→        \"\\n  format_1000_rows peak RAM: {:.1} KB\",\n   120→        PEAK_ALLOC.peak_usage_as_kb()\n   121→    );\n   122→\n   123→    group.finish();\n   124→}\n   125→\n   126→fn bench_insert_scaling(c: &mut Criterion) {\n   127→    let mut group = c.benchmark_group(\"shell_insert\");\n   128→\n   129→    for size in [100, 500, 1000] {\n   130→        PEAK_ALLOC.reset_peak_usage();\n   131→        group.bench_with_input(BenchmarkId::new(\"rows\", size), &size, |b, &size| {\n   132→            b.iter_batched(\n   133→                Shell::new,\n   134→                |mut shell| {\n   135→                    let _ = shell.execute(\"CREATE TABLE test (id INT, data TEXT)\");\n   136→                    for i in 0..size {\n   137→                        let _ = shell.execute(&format!(\"INSERT INTO test VALUES ({i}, 'data{i}')\"));\n   138→                    }\n   139→                },\n   140→                criterion::BatchSize::SmallInput,\n   141→            );\n   142→        });\n   143→        println!(\n   144→            \"\\n  insert_{} peak RAM: {:.1} KB\",\n   145→            size,\n   146→            PEAK_ALLOC.peak_usage_as_kb()\n   147→        );\n   148→    }\n   149→\n   150→    group.finish();\n   151→}\n   152→\n   153→criterion_group!(\n   154→    benches,\n   155→    bench_execute_commands,\n   156→    bench_format_output,\n   157→    bench_insert_scaling\n   158→);\n   159→criterion_main!(benches);\n   160→"}]},"uuid":"71971f70-d3ad-49bc-8608-ff4ceec04ddc","timestamp":"2026-03-13T00:08:35.869Z"},"type":"agent_progress","prompt":"","agentId":"ad55a98516aea1158"},"toolUseID":"agent_msg_011vunxUjTLB2UEc3fQjFCEq","parentToolUseID":"toolu_01PzySmwPEeqADbqkJdeKhub","uuid":"ccc34146-a866-461c-990a-788e74925e55","timestamp":"2026-03-13T00:08:36.278Z"}
