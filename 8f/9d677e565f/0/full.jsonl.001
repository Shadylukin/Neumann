{"parentUuid":"bafd2028-7084-404c-9543-9c3c1496ae4a","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012RCP78ZWRAyks7uAgxd3PB","type":"tool_result","content":"     1→[package]\n     2→name = \"neumann\"\n     3→version.workspace = true\n     4→edition.workspace = true\n     5→license.workspace = true\n     6→repository.workspace = true\n     7→homepage.workspace = true\n     8→rust-version.workspace = true\n     9→description = \"Interactive CLI shell for Neumann database\"\n    10→readme = \"README.md\"\n    11→keywords = [\"database\", \"cli\", \"tensor\", \"shell\", \"repl\"]\n    12→categories = [\"database\", \"command-line-utilities\"]\n    13→exclude = [\"benches/*\", \"*.profraw\"]\n    14→\n    15→[dependencies]\n    16→query_router.workspace = true\n    17→relational_engine.workspace = true\n    18→tensor_store.workspace = true\n    19→tensor_compress.workspace = true\n    20→tensor_chain.workspace = true\n    21→tensor_checkpoint.workspace = true\n    22→tensor_unified.workspace = true\n    23→rustyline = \"17\"\n    24→base64.workspace = true\n    25→parking_lot.workspace = true\n    26→clap = { workspace = true, features = [\"env\"] }\n    27→\n    28→# Terminal UX\n    29→owo-colors = \"4\"\n    30→indicatif = \"0.18\"\n    31→tabled = { version = \"0.17\", default-features = false, features = [\"std\", \"derive\"] }\n    32→console = \"0.16\"\n    33→\n    34→# TRO (Tensor Rust Organism) border animation\n    35→crossbeam-channel.workspace = true\n    36→smallvec = \"1.11\"\n    37→rand.workspace = true\n    38→\n    39→# System info for doctor diagnostics\n    40→sys-info = \"0.9\"\n    41→\n    42→# TLS certificate parsing for doctor diagnostics\n    43→x509-parser.worksp