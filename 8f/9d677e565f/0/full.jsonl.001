{"parentUuid":"c17f9ab8-0ac8-491e-a903-22ff6447b1b7","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xcwve6knh9W8YPwH21cAMu","type":"tool_result","content":"     1→[workspace]\n     2→resolver = \"2\"\n     3→members = [\n     4→    \"tensor_store\",\n     5→    \"relational_engine\",\n     6→    \"graph_engine\",\n     7→    \"vector_engine\",\n     8→    \"query_router\",\n     9→    \"neumann_parser\",\n    10→    \"neumann_shell\",\n    11→    \"neumann_client\",\n    12→    \"neumann_server\",\n    13→    \"tensor_compress\",\n    14→    \"tensor_vault\",\n    15→    \"tensor_cache\",\n    16→    \"tensor_blob\",\n    17→    \"integration_tests\",\n    18→    \"tensor_unified\",\n    19→    \"tensor_checkpoint\",\n    20→    \"tensor_chain\",\n    21→    \"stress_tests\",\n    22→    \"examples\",\n    23→    \"tensor_spatial\",\n    24→]\n    25→exclude = [\"fuzz\", \"neumann-py/neumann-native\", \"experiments\", \"seed_model\", \"demos/knowledge-galaxy\"]\n    26→\n    27→[workspace.package]\n    28→version = \"0.3.1\"\n    29→authors = [\"Lukin Ackroyd <lukin@scrunchee.ai>\"]\n    30→edition = \"2021\"\n    31→license = \"MIT OR Apache-2.0\"\n    32→repository = \"https://github.com/Shadylukin/Neumann\"\n    33→homepage = \"https://scrunchee.ai\"\n    34→documentation = \"https://github.com/Shadylukin/Neumann/tree/main/docs\"\n    35→keywords = [\"database\", \"tensor\", \"graph\", \"vector\", \"unified\"]\n    36→categories = [\"database\", \"data-structures\"]\n    37→rust-version = \"1.75\"\n    38→\n    39→[workspace.dependencies]\n    40→# Async runtime\n    41→tokio = { version = \"1\" }\n    42→async-trait = \"0.1\"\n    43→futures = \"0.3\"\n    44→tokio-stream = \"0.1\"\n    45→tokio-test = \"0.4\"\n    46→\n    47→# Serialization\n    48→serde = { version = \"1\", features = [\"derive\"] }\n    49→serde_json = \"1\"\n    50→bitcode = { version = \"0.6\", features = [\"serde\"] }\n    51→prost = \"0.14\"\n    52→\n    53→# gRPC\n    54→tonic = { version = \"0.14\", features = [\"gzip\", \"tls-ring\"] }\n    55→tonic-prost = \"0.14\"\n    56→tonic-prost-build = \"0.14\"\n    57→\n    58→# Concurrency\n    59→arc-swap = \"1\"\n    60→parking_lot = \"0.12\"\n    61→dashmap = \"6\"\n    62→rayon = \"1.10\"\n    63→crossbeam-channel = \"0.5\"\n    64→\n    65→# Crypto\n    66→sha2 = \"0.10\"\n    67→blake2 = \"0.10\"\n    68→rand = \"0.9\"\n    69→uuid = { version = \"1\", features = [\"v4\"] }\n    70→zeroize = { version = \"1\", features = [\"derive\"] }\n    71→\n    72→# Error handling\n    73→thiserror = \"2\"\n    74→\n    75→# Observability\n    76→tracing = \"0.1\"\n    77→tracing-subscriber = { version = \"0.3\", features = [\"env-filter\"] }\n    78→\n    79→# CLI / Terminal\n    80→clap = { version = \"4\", features = [\"derive\"] }\n    81→\n    82→# Storage\n    83→memmap2 = \"0.9\"\n    84→tempfile = \"3\"\n    85→crc32fast = \"1.4\"\n    86→\n    87→# TLS / Certificates\n    88→x509-parser = \"0.18\"\n    89→rcgen = \"0.13\"\n    90→\n    91→# Misc\n    92→hex = \"0.4\"\n    93→base64 = \"0.22\"\n    94→libc = \"0.2\"\n    95→bytes = \"1\"\n    96→\n    97→# Testing\n    98→criterion = { version = \"0.5\", features = [\"html_reports\"] }\n    99→\n   100→# Internal crates (path + version for crates.io)"}]},"uuid":"97572275-aab2-4f59-a284-358a9a08129b","timestamp":"2026-03-12T23:54:08.479Z"},"type":"agent_progress","prompt":"","agentId":"a0944e019bb88b7c8"},"toolUseID":"agent_msg_01EcgRprfQAupvyepQNfKaAL","parentToolUseID":"toolu_01HzFCXGiYN8Ncit5b2yYSgo","uuid":"1ffcb8d3-566f-41eb-8d71-036353b26d51","timestamp":"2026-03-12T23:54:08.480Z"}
