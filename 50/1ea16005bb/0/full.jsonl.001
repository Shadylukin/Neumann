{"parentUuid":"ec4b344a-cd92-484c-9491-5d856f6e85ed","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Aog9ubGp83WDMyJtjnbkU","type":"tool_result","content":"<persisted-output>\nOutput too large (64.1KB). Full output saved to: /Users/lukin/.claude/projects/-Users-lukin-Neumann/f409b145-d62e-472d-b034-4de3a5b13ab9/tool-results/toolu_019Aog9ubGp83WDMyJtjnbkU.txt\n\nPreview (first 2KB):\n     1→// SPDX-License-Identifier: MIT OR Apache-2.0\n     2→//! Benchmarks for tensor_chain blockchain operations.\n     3→//!\n     4→//! Covers:\n     5→//! - Block creation and appending\n     6→//! - Transaction commit latency\n     7→//! - Batch transaction throughput\n     8→//! - Consensus validation (semantic conflict detection)\n     9→//! - Codebook operations (GlobalCodebook/LocalCodebook)\n    10→//! - Delta vector operations\n    11→//! - Chain queries (by height, history)\n    12→//! - Raft consensus operations\n    13→//! - 2PC distributed transactions\n    14→//! - Gossip protocol operations\n    15→//! - Snapshot operations\n    16→//! - Membership management\n    17→//! - Deadlock detection\n    18→#![allow(missing_docs)]\n    19→\n    20→use std::{collections::HashSet, sync::Arc};\n    21→\n    22→use criterion::{black_box, criterion_group, criterion_main, BenchmarkId, Criterion, Throughput};\n    23→use tensor_chain::{\n    24→    Chain, CodebookManager, ConsensusConfig, ConsensusManager, DeltaVector, GlobalCodebook,\n    25→    LocalCodebook, TensorChain, Transaction,\n    26→};\n    27→use tensor_store::TensorStore;\n    28→\n    29→// ============================================================================\n    30→// Block Creation Benchmarks\n    31→// ============================================================================\n    32→\n    33→fn bench_block_creation(c: &mut Criterion) {\n    34→    let mut group = c.benchmark_group(\"block_creation\");\n    35→    let store = TensorStore::new();\n    36→    let graph = Arc::new(graph_engine::GraphEngine::with_store(store));\n    37→    let chain = Chain::new(graph.clone(), \"bench_node\".to_string());\n    38→    chain.initialize().unwrap();\n    39→\n    40→    group.bench_function(\"empty_block\", |b| {\n    41→        b.iter(|| {\n    42→            let block = chain.new_block().build();\n    43→            black_box(block)\n    44→        })\n    45→    });\n    46→\n    47→    group.bench_function(\"block_10_txns\", |b| {\n...\n</persisted-output>"}]},"uuid":"d2d61fc5-c949-4baf-988f-a4dd4573be58","timestamp":"2026-03-12T19:04:02.132Z"},"type":"agent_progress","prompt":"","agentId":"ad6033ad35f3b66f2"},"toolUseID":"agent_msg_01T7UE2NearPHwyDWHRMfyRp","parentToolUseID":"toolu_01LcDD5yVcNtDyodJTryvynF","uuid":"db7f7bd0-3453-4261-a022-a2ddcb6f955f","timestamp":"2026-03-12T19:04:02.132Z"}
{"parentUuid":"db7f7bd0-3453-4261-a022-a2ddcb6f955f","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"assistant","timestamp":"2026-03-12T19:04:05.598Z","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01KZVKPv9Yk9RdEp4oDt63aD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0177kKDDhPxMiBPkdNrurpLt","name":"Read","input":{"file_path":"/Users/lukin/Neumann/tensor_compress/benches/tensor_compress_bench.rs"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":5,"cache_creation_input_tokens":19517,"cache_read_input_tokens":83343,"cache_creation":{"ephemeral_5m_input_tokens":19517,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"requestId":"req_011CYyhvBvWPd8b3wsgaTRz8","uuid":"d1b534b7-6ff0-4efa-b035-98cb000adc56"},"type":"agent_progress","prompt":"","agentId":"ad6033ad35f3b66f2"},"toolUseID":"agent_msg_01T7UE2NearPHwyDWHRMfyRp","parentToolUseID":"toolu_01LcDD5yVcNtDyodJTryvynF","uuid":"6cabcf39-3201-416d-9fe6-05b6465db956","timestamp":"2026-03-12T19:04:05.598Z"}
{"parentUuid":"6cabcf39-3201-416d-9fe6-05b6465db956","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0177kKDDhPxMiBPkdNrurpLt","type":"tool_result","content":"     1→// SPDX-License-Identifier: MIT OR Apache-2.0\n     2→#![allow(missing_docs)]\n     3→use criterion::{black_box, criterion_group, criterion_main, Criterion};\n     4→use peak_alloc::PeakAlloc;\n     5→use tensor_compress::{\n     6→    compress_ids, decompress_ids, rle_decode, rle_encode, tt_cosine_similarity, tt_decompose,\n     7→    tt_dot_product, tt_reconstruct, TTConfig,\n     8→};\n     9→\n    10→#[global_allocator]\n    11→static PEAK_ALLOC: PeakAlloc = PeakAlloc;\n    12→\n    13→fn bench_delta_compress(c: &mut Criterion) {\n    14→    let ids: Vec<u64> = (0..10_000).collect();\n    15→\n    16→    PEAK_ALLOC.reset_peak_usage();\n    17→    c.bench_function(\"compress_ids_10k_sequential\", |b| {\n    18→        b.iter(|| compress_ids(black_box(&ids)));\n    19→    });\n    20→    println!(\n    21→        \"  compress_ids_10k peak RAM: {:.1} KB\",\n    22→        PEAK_ALLOC.peak_usage_as_kb()\n    23→    );\n    24→}\n    25→\n    26→fn bench_delta_decompress(c: &mut Criterion) {\n    27→    let ids: Vec<u64> = (0..10_000).collect();\n    28→    let compressed = compress_ids(&ids);\n    29→\n    30→    PEAK_ALLOC.reset_peak_usage();\n    31→    c.bench_function(\"decompress_ids_10k_sequential\", |b| {\n    32→        b.iter(|| decompress_ids(black_box(&compressed)));\n    33→    });\n    34→    println!(\n    35→        \"  decompress_ids_10k peak RAM: {:.1} KB\",\n    36→        PEAK_ALLOC.peak_usage_as_kb()\n    37→    );\n    38→}\n    39→\n    40→fn bench_rle_encode(c: &mut Criterion) {\n    41→    let data: Vec<i32> = (0..1000).flat_map(|i| vec![i % 10; 100]).collect();\n    42→\n    43→    PEAK_ALLOC.reset_peak_usage();\n    44→    c.bench_function(\"rle_encode_100k_values\", |b| {\n    45→        b.iter(|| rle_encode(black_box(&data)));\n    46→    });\n    47→    println!(\n    48→        \"  rle_encode_100k peak RAM: {:.1} KB\",\n    49→        PEAK_ALLOC.peak_usage_as_kb()\n    50→    );\n    51→}\n    52→\n    53→fn bench_rle_decode(c: &mut Criterion) {\n    54→    let data: Vec<i32> = (0..1000).flat_map(|i| vec![i % 10; 100]).collect();\n    55→    let encoded = rle_encode(&data);\n    56→\n    57→    PEAK_ALLOC.reset_peak_usage();\n    58→    c.bench_function(\"rle_decode_100k_values\", |b| {\n    59→        b.iter(|| rle_decode(black_box(&encoded)));\n    60→    });\n    61→    println!(\n    62→        \"  rle_decode_100k peak RAM: {:.1} KB\",\n    63→        PEAK_ALLOC.peak_usage_as_kb()\n    64→    );\n    65→}\n    66→\n    67→// Tensor Train (TT) decomposition benchmarks\n    68→\n    69→fn bench_tt_decompose_256d(c: &mut Criterion) {\n    70→    let vector: Vec<f32> = (0..256_u16).map(|i| f32::from(i).sin()).collect();\n    71→    let config = TTConfig::for_dim(256).unwrap();\n    72→\n    73→    PEAK_ALLOC.reset_peak_usage();\n    74→    c.bench_function(\"tt_decompose_256d\", |b| {\n    75→        b.iter(|| tt_decompose(black_box(&vector), black_box(&config)));\n    76→    });\n    77→    println!(\n    78→        \"\\n  tt_decompose_256d peak RAM: {:.1} KB\",\n    79→        PEAK_ALLOC.peak_usage_as_kb()\n    80→    );\n    81→}\n    82→\n    83→fn bench_tt_decompose_1024d(c: &mut Criterion) {\n    84→    let vector: Vec<f32> = (0..1024_u16).map(|i| f32::from(i).sin()).collect();\n    85→    let config = TTConfig::for_dim(1024).unwrap();\n    86→\n    87→    PEAK_ALLOC.reset_peak_usage();\n    88→    c.bench_function(\"tt_decompose_1024d\", |b| {\n    89→        b.iter(|| tt_decompose(black_box(&vector), black_box(&config)));\n    90→    });\n    91→    println!(\n    92→        \"  tt_decompose_1024d peak RAM: {:.1} KB\",\n    93→        PEAK_ALLOC.peak_usage_as_kb()\n    94→    );\n    95→}\n    96→\n    97→fn bench_tt_decompose_4096d(c: &mut Criterion) {\n    98→    let vector: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).sin()).collect();\n    99→    let config = TTConfig::for_dim(4096).unwrap();\n   100→\n   101→    PEAK_ALLOC.reset_peak_usage();\n   102→    c.bench_function(\"tt_decompose_4096d\", |b| {\n   103→        b.iter(|| tt_decompose(black_box(&vector), black_box(&config)));\n   104→    });\n   105→    println!(\n   106→        \"  tt_decompose_4096d peak RAM: {:.1} KB\",\n   107→        PEAK_ALLOC.peak_usage_as_kb()\n   108→    );\n   109→}\n   110→\n   111→fn bench_tt_reconstruct_4096d(c: &mut Criterion) {\n   112→    let vector: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).sin()).collect();\n   113→    let config = TTConfig::for_dim(4096).unwrap();\n   114→    let tt = tt_decompose(&vector, &config).unwrap();\n   115→\n   116→    PEAK_ALLOC.reset_peak_usage();\n   117→    c.bench_function(\"tt_reconstruct_4096d\", |b| {\n   118→        b.iter(|| tt_reconstruct(black_box(&tt)));\n   119→    });\n   120→    println!(\n   121→        \"  tt_reconstruct_4096d peak RAM: {:.1} KB\",\n   122→        PEAK_ALLOC.peak_usage_as_kb()\n   123→    );\n   124→}\n   125→\n   126→fn bench_tt_dot_product_4096d(c: &mut Criterion) {\n   127→    let v1: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).sin()).collect();\n   128→    let v2: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).cos()).collect();\n   129→    let config = TTConfig::for_dim(4096).unwrap();\n   130→    let tt1 = tt_decompose(&v1, &config).unwrap();\n   131→    let tt2 = tt_decompose(&v2, &config).unwrap();\n   132→\n   133→    PEAK_ALLOC.reset_peak_usage();\n   134→    c.bench_function(\"tt_dot_product_4096d\", |b| {\n   135→        b.iter(|| tt_dot_product(black_box(&tt1), black_box(&tt2)));\n   136→    });\n   137→    println!(\n   138→        \"  tt_dot_product_4096d peak RAM: {:.1} KB\",\n   139→        PEAK_ALLOC.peak_usage_as_kb()\n   140→    );\n   141→}\n   142→\n   143→fn bench_tt_cosine_similarity_4096d(c: &mut Criterion) {\n   144→    let v1: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).sin()).collect();\n   145→    let v2: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).cos()).collect();\n   146→    let config = TTConfig::for_dim(4096).unwrap();\n   147→    let tt1 = tt_decompose(&v1, &config).unwrap();\n   148→    let tt2 = tt_decompose(&v2, &config).unwrap();\n   149→\n   150→    PEAK_ALLOC.reset_peak_usage();\n   151→    c.bench_function(\"tt_cosine_similarity_4096d\", |b| {\n   152→        b.iter(|| tt_cosine_similarity(black_box(&tt1), black_box(&tt2)));\n   153→    });\n   154→    println!(\n   155→        \"  tt_cosine_similarity_4096d peak RAM: {:.1} KB\",\n   156→        PEAK_ALLOC.peak_usage_as_kb()\n   157→    );\n   158→}\n   159→\n   160→fn bench_tt_compression_ratio(c: &mut Criterion) {\n   161→    let vector: Vec<f32> = (0..4096_u16).map(|i| f32::from(i).sin()).collect();\n   162→    let config = TTConfig::for_dim(4096).unwrap();\n   163→\n   164→    c.bench_function(\"tt_compression_ratio_4096d\", |b| {\n   165→        b.iter(|| {\n   166→            let tt = tt_decompose(black_box(&vector), black_box(&config)).unwrap();\n   167→            let ratio = tt.compression_ratio();\n   168→            black_box(ratio)\n   169→        });\n   170→    });\n   171→}\n   172→\n   173→criterion_group!(\n   174→    benches,\n   175→    bench_delta_compress,\n   176→    bench_delta_decompress,\n   177→    bench_rle_encode,\n   178→    bench_rle_decode,\n   179→    bench_tt_decompose_256d,\n   180→    bench_tt_decompose_1024d,\n   181→    bench_tt_decompose_4096d,\n   182→    bench_tt_reconstruct_4096d,\n   183→    bench_tt_dot_product_4096d,\n   184→    bench_tt_cosine_similarity_4096d,\n   185→    bench_tt_compression_ratio,\n   186→);\n   187→criterion_main!(benches);\n   188→"}]},"uuid":"7d837a55-ca99-461d-8a1b-98c31557aea2","timestamp":"2026-03-12T19:04:05.625Z"},"type":"agent_progress","prompt":"","agentId":"ad6033ad35f3b66f2"},"toolUseID":"agent_msg_01T7UE2NearPHwyDWHRMfyRp","parentToolUseID":"toolu_01LcDD5yVcNtDyodJTryvynF","uuid":"776fba74-c80d-4a70-9492-6d5d9ca98fdc","timestamp":"2026-03-12T19:04:05.807Z"}
