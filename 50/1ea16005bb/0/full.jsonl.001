{"parentUuid":"3f3dc1aa-4cf1-4033-ab85-1954ff672835","isSidechain":false,"userType":"external","cwd":"/Users/lukin/Neumann","sessionId":"f409b145-d62e-472d-b034-4de3a5b13ab9","version":"2.1.72","gitBranch":"publish-and-snapshot-improvements","slug":"mighty-hugging-umbrella","type":"progress","data":{"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LsDn42zjuRVNLqzzzwQRDi","type":"tool_result","content":"     1→// SPDX-License-Identifier: MIT OR Apache-2.0\n     2→#![allow(missing_docs)]\n     3→\n     4→use criterion::{black_box, criterion_group, criterion_main, Criterion, Throughput};\n     5→use tempfile::tempdir;\n     6→use tensor_store::{ScalarValue, TensorData, TensorStore, TensorValue, WalConfig};\n     7→\n     8→fn create_test_data(id: i64) -> TensorData {\n     9→    let mut data = TensorData::new();\n    10→    data.set(\"id\", TensorValue::Scalar(ScalarValue::Int(id)));\n    11→    data.set(\n    12→        \"name\",\n    13→        TensorValue::Scalar(ScalarValue::String(format!(\"entity_{}\", id))),\n    14→    );\n    15→    data.set(\n    16→        \"embedding\",\n    17→        TensorValue::Vector(vec![id as f32; 128]), // 128-dim embedding (same as tensor_store_bench)\n    18→    );\n    19→    data\n    20→}\n    21→\n    22→fn bench_wal_write_immediate(c: &mut Criterion) {\n    23→    let mut group = c.benchmark_group(\"wal_immediate\");\n    24→\n    25→    // Only test 100 for immediate mode (it's slow)\n    26→    let size = 100;\n    27→    group.throughput(Throughput::Elements(size as u64));\n    28→    group.bench_function(\"write_100\", |b| {\n    29→        b.iter_with_setup(\n    30→            || {\n    31→                let dir = tempdir().unwrap();\n    32→                let wal_path = dir.path().join(\"bench.wal\");\n    33→                let store = TensorStore::open_durable(&wal_path, WalConfig::default()).unwrap();\n    34→                (dir, store)\n    35→            },\n    36→            |(_dir, store)| {\n    37→                for i in 0..size {\n    38→                    store\n    39→                        .put_durable(format!(\"key_{}\", i), create_test_data(i))\n    40→                        .unwrap();\n    41→                }\n    42→            },\n    43→        );\n    44→    });\n    45→    group.finish();\n    46→}\n    47→\n    48→fn bench_wal_write_batched(c: &mut Criterion) {\n    49→    let mut group = c.benchmark_group(\"wal_batched\");\n    50→\n    51→    for size in [100, 1000, 10000] {\n    52→        group.throughput(Throughput::Elements(size as u64));\n    53→        group.bench_function(format!(\"write_{}\", size), |b| {\n    54→            b.iter_with_setup(\n    55→                || {\n    56→                    let dir = tempdir().unwrap();\n    57→                    let wal_path = dir.path().join(\"bench.wal\");\n    58→                    // Batched mode: fsync every 100 entries\n    59→                    let config = WalConfig::batched(100);\n    60→                    let store = TensorStore::open_durable(&wal_path, config).unwrap();\n    61→                    (dir, store)\n    62→                },\n    63→                |(_dir, store)| {\n    64→                    for i in 0..size {\n    65→                        store\n    66→                            .put_durable(format!(\"key_{}\", i), create_test_data(i))\n    67→                            .unwrap();\n    68→                    }\n    69→                    // Final sync for any remaining entries\n    70→                    store.sync().unwrap();\n    71→                },\n    72→            );\n    73→        });\n    74→    }\n    75→    group.finish();\n    76→}\n    77→\n    78→fn bench_wal_recovery(c: &mut Criterion) {\n    79→    let mut group = c.benchmark_group(\"wal_recovery\");\n    80→\n    81→    for size in [100, 1000, 10000] {\n    82→        group.throughput(Throughput::Elements(size as u64));\n    83→        group.bench_function(format!(\"recover_{}\", size), |b| {\n    84→            let dir = tempdir().unwrap();\n    85→            let wal_path = dir.path().join(\"bench.wal\");\n    86→            {\n    87→                let store = TensorStore::open_durable(&wal_path, WalConfig::default()).unwrap();\n    88→                for i in 0..size {\n    89→                    store\n    90→                        .put(format!(\"key_{}\", i), create_test_data(i))\n    91→                        .unwrap();\n    92→                }\n    93→            }\n    94→\n    95→            b.iter(|| {\n    96→                let recovered = TensorStore::recover(\n    97→                    black_box(&wal_path),\n    98→                    black_box(&WalConfig::default()),\n    99→                    black_box(None::<&std::path::Path>),\n   100→                )\n   101→                .unwrap();\n   102→                black_box(recovered)\n   103→            });\n   104→        });\n   105→    }\n   106→    group.finish();\n   107→}\n   108→\n   109→criterion_group!(\n   110→    wal_benches,\n   111→    bench_wal_write_immediate,\n   112→    bench_wal_write_batched,\n   113→    bench_wal_recovery\n   114→);\n   115→criterion_main!(wal_benches);\n   116→"}]},"uuid":"3b4dc16c-88c9-4352-87b7-6dda4343919a","timestamp":"2026-03-12T19:04:01.395Z"},"type":"agent_progress","prompt":"","agentId":"ad6033ad35f3b66f2"},"toolUseID":"agent_msg_01T7UE2NearPHwyDWHRMfyRp","parentToolUseID":"toolu_01LcDD5yVcNtDyodJTryvynF","uuid":"cba53e01-27f2-4b19-896c-d0d9008894b9","timestamp":"2026-03-12T19:04:01.606Z"}
